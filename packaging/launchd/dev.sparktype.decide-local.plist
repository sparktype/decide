<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sparktype.decide-local</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/decide/jev-style/bin/jev-style</string>
    <string>serve</string>
    <string>--release</string>
    <string>2b</string>
    <string>--precision</string>
    <string>8bit</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/decide-local.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/decide-local.log</string>
</dict>
</plist>
